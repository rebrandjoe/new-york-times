NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — from Supabase project settings > API. Never expose to the browser.
# Required for subscription activation, admin subscriber lookups, and the cron sweep.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build absolute redirect/callback URLs for checkout.
NEXT_PUBLIC_SITE_URL=https://josephmmwa.com

# Flutterwave — handles M-Pesa and card payments. From the Flutterwave dashboard.
FLUTTERWAVE_SECRET_KEY=
# The shared hash configured under Settings > Webhooks in the Flutterwave dashboard.
FLUTTERWAVE_SECRET_HASH=

# PayPal — from developer.paypal.com. Use sandbox credentials until ready to go live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the webhook's details page after creating it in the PayPal developer dashboard.
PAYPAL_WEBHOOK_ID=
# https://api-m.sandbox.paypal.com while testing; https://api-m.paypal.com once live.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Transactional email (subscription confirmations, renewal reminders) — shared
# provider for this and, later, The MMWA Briefing newsletter.
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM="JOSEPH MMWA <notifications@josephmmwa.com>"

# A random secret you choose — set the same value here and in Vercel's
# environment variables so the daily subscription-sweep cron can authenticate.
CRON_SECRET=
